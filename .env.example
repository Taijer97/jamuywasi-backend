# ---------- Entorno ----------
# production: oculta /docs y exige CORS_ORIGINS con dominios concretos
ENVIRONMENT=production

# ---------- Base de datos (MySQL) ----------
# Si MySQL corre en el mismo servidor fuera de Docker usa host.docker.internal o la IP privada
DATABASE_URL=mysql+aiomysql://usuario:clave@host:3306/atalaya_store

# ---------- Almacenamiento de imágenes (MinIO) ----------
MINIO_ENDPOINT=host:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=atalaya-store
MINIO_SECURE=false

# ---------- Seguridad ----------
# Genera uno con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Solo para migrar PIN antiguos (primeros 16 caracteres del JWT_SECRET anterior)
LEGACY_PASSWORD_SALT=
# CORS: déjalo VACÍO si la web se sirve con el Nginx del frontend (mismo dominio que la API).
# Solo si la web está en otro dominio: CORS_ORIGINS=https://tu-dominio.com,https://www.tu-dominio.com
# ("*" no se permite en producción)
CORS_ORIGINS=

# ---------- Verificación Yape ----------
URL_YAPE_VERIFY=
TOKEN_YAPE=

# ---------- Docker (opcional) ----------
# Puerto local del servidor donde se publica la API (solo 127.0.0.1)
API_PORT=8000
# Número de procesos (dejar en 1 hasta tener Redis)
WEB_CONCURRENCY=1
