# ---------- Entorno ----------
# production: oculta /docs y exige CORS_ORIGINS con dominios concretos
ENVIRONMENT=production

# ---------- Base de datos (MySQL) ----------
# Si MySQL corre en el mismo servidor fuera de Docker usa host.docker.internal o la IP privada
DATABASE_URL=mysql+aiomysql://usuario:clave@host:3306/atalaya_store

# ---------- Almacenamiento de imágenes (MinIO) ----------
MINIO_ENDPOINT=host:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=atalaya-store
MINIO_SECURE=false

# Concurrencia de subidas de imágenes (opcional; valores por defecto probados con 300 subidas a la vez)
# Máximo de imágenes procesándose a la vez (las demás esperan su turno sin gastar memoria)
UPLOAD_CONCURRENCY=16
# Hilos dedicados para hablar con MinIO
STORAGE_THREADS=16
# Tamaño máximo por imagen en MB (el navegador ya las comprime a < 400 KB)
MAX_UPLOAD_MB=5

# ---------- Seguridad ----------
# Genera uno con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Solo para migrar PIN antiguos (primeros 16 caracteres del JWT_SECRET anterior)
LEGACY_PASSWORD_SALT=
# CORS: déjalo VACÍO si la web se sirve con el Nginx del frontend (mismo dominio que la API).
# Solo si la web está en otro dominio: CORS_ORIGINS=https://tu-dominio.com,https://www.tu-dominio.com
# ("*" no se permite en producción)
CORS_ORIGINS=

# ---------- Verificación Yape ----------
URL_YAPE_VERIFY=
TOKEN_YAPE=

# ---------- Docker (opcional) ----------
# Puerto local del servidor donde se publica la API (solo 127.0.0.1)
API_PORT=8000
# Número de procesos (dejar en 1 hasta tener Redis)
WEB_CONCURRENCY=1

# Dirección pública de la web (vista previa de enlaces en WhatsApp)
PUBLIC_BASE_URL=https://tu-dominio.com

# ---------- Crecimiento (Fase 2) ----------
# Redis: comparte WebSocket, caché y límites entre varios procesos del backend (WEB_CONCURRENCY>1).
# Con infra/docker-compose.yml: redis://redis:6379/0   (vacío = un solo proceso, todo en memoria)
REDIS_URL=redis://redis:6379/0
# Subida directa del navegador a MinIO a través de Nginx (/s3-upload). false = la foto pasa por la API.
DIRECT_UPLOADS=true
# Región con la que se firman las subidas (MinIO usa us-east-1 por defecto)
MINIO_REGION=us-east-1
